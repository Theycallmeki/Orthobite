# OrthoBite Backend Environment Variables
APP_NAME=OrthoBite API
DEBUG=True

# Database (use SQLite locally or PostgreSQL)
DATABASE_URL=sqlite:///./orthobite.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/orthobite

# JWT Security
SECRET_KEY=change-me-in-production-orthobite-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@orthobite.com

RESEND_API_KEY=
BREVO_API_KEY=
